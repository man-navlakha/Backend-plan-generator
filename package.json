{
  "name": "backend-plan-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Backend plan generator API",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test",
    "start": "node src/server.js",
    "start:local": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "vercel-build": "npm run rules:validate",
    "rules:validate": "node -e \"console.log(JSON.stringify(require('./src/rules').validateAllRules(),null,2))\"",
    "db:setup": "node --env-file=.env scripts/db-setup.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "node-appwrite": "^29.0.0",
    "openai": "^7.21.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=20.x"
  }
}
