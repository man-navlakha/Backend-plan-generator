{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "npm run vercel-build",

  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "src/assets/Masters/Cinema/Images/**"
    }
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
