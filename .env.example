# Copy to .env and fill in. Never commit the real file.
# Local runs: node --env-file=.env src/server.js
# Vercel: set these in Project Settings -> Environment Variables.

PORT=3000

# Appwrite Storage — where a generated plan workbook is uploaded.
# The API key needs files.read and files.write scopes on this bucket.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_PLANS_BUCKET_ID=

# Postgres (Railway). Holds the unified master catalog and every generated plan.
DB_URL=postgresql://user:password@host:port/database
DB_POOL_MAX=5

# OpenAI API - reviews the CRM brief and selects inventory from the catalog.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: use a different model only for free-text CRM brief extraction.
OPENAI_BRIEF_MODEL=
PLAN_MAX_TOOL_ROUNDS=6


# Canonical public origin used in returned workbook links. No trailing slash.
PUBLIC_BASE_URL=https://backend-plan-generator.vercel.app
